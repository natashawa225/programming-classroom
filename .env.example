# Supabase (public client config)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Teacher accounts (server-only; do NOT prefix with NEXT_PUBLIC_).
# Each teacher signs in with their own username + password, stored (bcrypt-hashed)
# in the `teachers` table. Provision accounts with scripts/generate-teacher-seed.mjs.
#
# Secret used to sign teacher session cookies. Required; generate with e.g.
# `openssl rand -base64 32`. Falls back to SUPABASE_SERVICE_ROLE_KEY if unset.
TEACHER_SESSION_SECRET=
# Optional: session cookie lifetime (seconds). Default is 8 hours.
TEACHER_DASHBOARD_SESSION_MAX_AGE_SECONDS=28800

